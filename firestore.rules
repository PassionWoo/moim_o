rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null && request.auth.token.email in [
        'member01@team-plan.example.com',
        'member02@team-plan.example.com',
        'member03@team-plan.example.com',
        'member04@team-plan.example.com',
        'member05@team-plan.example.com',
        'member06@team-plan.example.com'
      ];
    }
    function own(id) {
      return member() && (
        (id == 'kimdeok' && request.auth.token.email == 'member01@team-plan.example.com') ||
        (id == 'kimwon' && request.auth.token.email == 'member02@team-plan.example.com') ||
        (id == 'kimjeong' && request.auth.token.email == 'member03@team-plan.example.com') ||
        (id == 'wooseong' && request.auth.token.email == 'member04@team-plan.example.com') ||
        (id == 'leeun' && request.auth.token.email == 'member05@team-plan.example.com') ||
        (id == 'cheonyun' && request.auth.token.email == 'member06@team-plan.example.com')
      );
    }
    function valid() {
      return request.resource.data.keys().hasOnly(['slots']) &&
        request.resource.data.keys().hasAll(['slots']) &&
        request.resource.data.slots is map &&
        request.resource.data.slots.keys().hasOnly([
          'd0s0','d0s1','d0s2','d0s3','d0s4','d0s5',
          'd1s0','d1s1','d1s2','d1s3','d1s4','d1s5',
          'd2s0','d2s1','d2s2','d2s3','d2s4','d2s5',
          'd3s0','d3s1','d3s2','d3s3','d3s4','d3s5',
          'd4s0','d4s1','d4s2','d4s3','d4s4','d4s5',
          'd5s0','d5s1','d5s2','d5s3','d5s4','d5s5'
        ]) &&
        request.resource.data.slots.size() <= 36;
    }
    match /nov2026_schedules/{id} {
      allow get, list: if member();
      allow create, update: if own(id) && valid();
      allow delete: if false;
    }
    match /{everything=**} {
      allow read, write: if false;
    }
  }
}
